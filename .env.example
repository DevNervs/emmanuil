# Optional ownership verification tokens from the search-engine dashboards.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Public site origin used for canonical, sitemap, OG and JSON-LD.
# Leave empty to fall back to the default in app/data/site.ts.
NEXT_PUBLIC_SITE_URL=https://emmanuil.pages.dev

# Cloudflare Worker / Telegram integration for group registrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
