{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "test": "npm run build && npx tsx --test tests/rendered-html.test.mjs && npx tsx --test tests/header-theme-top.test.mjs",
    "test:unit": "npx tsx --test tests/rendered-html.test.mjs",
    "test:visual": "npx tsx --test tests/header-theme-top.test.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "build-worker": "node scripts/build-worker.mjs",
    "prebuild": "npm run build-worker",
    "predev": "npm run build-worker",
    "db:generate": "drizzle-kit generate",
    "build:pages": "npm run build && node scripts/prerender.mjs",
    "deploy": "npm run build:pages && wrangler pages deploy dist/pages --project-name emmanuil --branch main",
    "deploy:preview": "npm run build:pages && wrangler pages deploy dist/pages --project-name emmanuil --branch preview"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hls.js": "^1.6.16",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.30",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.23.0",
    "eslint-config-next": "^16.2.12",
    "playwright": "^1.62.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vinext": "^1.0.0-beta.4",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "type": "module"
}
